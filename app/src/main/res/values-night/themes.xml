<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FmSimulation" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Use NoActionBar for Compose apps -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorSecondary">@color/teal_200</item>

        <!-- Make system bars transparent for Edge-to-Edge -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Disable Force Dark to prevent system from inverting colors incorrectly in Dark Mode -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>